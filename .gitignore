# Build / release artifacts
# NOTE: /dist/ and /cmd/wails-app/dist/ are NOT ignored: main.go and
# cmd/wails-app/main.go both use `go:embed all:dist`, so a clean clone must
# contain them or `go build ./...` fails with "pattern all:dist: no matching
# files found".
