    "xhs": {
      "urls": ["https://creator.xiaohongshu.com", "https://www.xiaohongshu.com"],
      "logged_in_cookie_names": ["web_session", "galaxy_creator_session_id", "access-token-creator.xiaohongshu.com"],
      "login_indicators": [{"text_contains":"扫码登录"}, {"query":"[class*='login-container']"}],
      "operations": {
        "login_check": [{"text_contains":"扫码登录"}, {"query":"[class*='login-container']"}],
        "publish.settings.visibility.public": [{"query":"[data-testid='visibility-public']"}, {"query":"[role='radio'][aria-label*='公开']"}, {"text_contains":"公开可见"}],
        "publish.settings.visibility.private": [{"query":"[data-testid='visibility-private']"}, {"query":"[role='radio'][aria-label*='私密']"}, {"text_contains":"私密"}],
